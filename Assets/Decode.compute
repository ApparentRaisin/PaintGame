// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel Decode

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
Texture2D<float4> Result;
Texture2DArray<float4> array;

struct CameraData{
    float4x4 _CameraTransform;
    float4x4 _FrustrumMatrix;
};

uniform RWStructuredBuffer<CameraData> camData;
int index;
inline float DecodeFloatRGBA(float4 enc) 
{
    uint ex = (uint)(enc.x * 255);
    uint ey = (uint)(enc.y * 255);
    uint ez = (uint)(enc.z * 255);
    uint ew = (uint)(enc.w * 255);
    float v = (ex << 24) + (ey << 16) + (ez << 8) + ew;
    return v / (256.0f * 256.0f * 256.0f * 256.0f);
}

[numthreads(1,1,1)]
void Decode(uint3 id : SV_DispatchThreadID){
    camData[index]._CameraTransform[0][0] = DecodeFloatRGBA(Result[float2(0 ,0)])*200.-100.;   
    camData[index]._CameraTransform[0][1] = DecodeFloatRGBA(Result[float2(1 ,0)])*200.-100.;
    camData[index]._CameraTransform[0][2] = DecodeFloatRGBA(Result[float2(2 ,0)])*200.-100.;
    camData[index]._CameraTransform[0][3] = DecodeFloatRGBA(Result[float2(3 ,0)])*200.-100.;
    camData[index]._CameraTransform[1][0] = DecodeFloatRGBA(Result[float2(4 ,0)])*200.-100.;
    camData[index]._CameraTransform[1][1] = DecodeFloatRGBA(Result[float2(5 ,0)])*200.-100.;
    camData[index]._CameraTransform[1][2] = DecodeFloatRGBA(Result[float2(6 ,0)])*200.-100.;
    camData[index]._CameraTransform[1][3] = DecodeFloatRGBA(Result[float2(7 ,0)])*200.-100.;
    camData[index]._CameraTransform[2][0] = DecodeFloatRGBA(Result[float2(8 ,0)])*200.-100.;
    camData[index]._CameraTransform[2][1] = DecodeFloatRGBA(Result[float2(9 ,0)])*200.-100.;
    camData[index]._CameraTransform[2][2] = DecodeFloatRGBA(Result[float2(10,0)])*200.-100.;
    camData[index]._CameraTransform[2][3] = DecodeFloatRGBA(Result[float2(11,0)])*200.-100.;
    camData[index]._CameraTransform[3][0] = DecodeFloatRGBA(Result[float2(12,0)])*200.-100.;
    camData[index]._CameraTransform[3][1] = DecodeFloatRGBA(Result[float2(13,0)])*200.-100.;
    camData[index]._CameraTransform[3][2] = DecodeFloatRGBA(Result[float2(14,0)])*200.-100.;
    camData[index]._CameraTransform[3][3] = DecodeFloatRGBA(Result[float2(15,0)])*200.-100.;
    
    camData[index]._FrustrumMatrix[0][0] = DecodeFloatRGBA(Result[float2(0 ,1)])*200.-100.;   
    camData[index]._FrustrumMatrix[0][1] = DecodeFloatRGBA(Result[float2(1 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[0][2] = DecodeFloatRGBA(Result[float2(2 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[0][3] = DecodeFloatRGBA(Result[float2(3 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[1][0] = DecodeFloatRGBA(Result[float2(4 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[1][1] = DecodeFloatRGBA(Result[float2(5 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[1][2] = DecodeFloatRGBA(Result[float2(6 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[1][3] = DecodeFloatRGBA(Result[float2(7 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[2][0] = DecodeFloatRGBA(Result[float2(8 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[2][1] = DecodeFloatRGBA(Result[float2(9 ,1)])*200.-100.;
    camData[index]._FrustrumMatrix[2][2] = DecodeFloatRGBA(Result[float2(10,1)])*200.-100.;
    camData[index]._FrustrumMatrix[2][3] = DecodeFloatRGBA(Result[float2(11,1)])*200.-100.;
    camData[index]._FrustrumMatrix[3][0] = DecodeFloatRGBA(Result[float2(12,1)])*200.-100.;
    camData[index]._FrustrumMatrix[3][1] = DecodeFloatRGBA(Result[float2(13,1)])*200.-100.;
    camData[index]._FrustrumMatrix[3][2] = DecodeFloatRGBA(Result[float2(14,1)])*200.-100.;
    camData[index]._FrustrumMatrix[3][3] = DecodeFloatRGBA(Result[float2(15,1)])*200.-100.;
}
