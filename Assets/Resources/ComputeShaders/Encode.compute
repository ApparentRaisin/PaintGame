// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel Encode

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> Result;

struct CameraData{
    float4x4 _CameraTransform;
    float4x4 _FrustrumMatrix;
};

uniform RWStructuredBuffer<float4x4> movingTransforms;
uniform RWStructuredBuffer<CameraData> camData;
int index;
inline float4 EncodeFloatRGBA(float v)
{
    uint vi = (uint)(v * (256.0f * 256.0f * 256.0f * 256.0f));
    int ex = (int)(vi / (256 * 256 * 256) % 256);
    int ey = (int)((vi / (256 * 256)) % 256);
    int ez = (int)((vi / (256)) % 256);
    int ew = (int)(vi % 256);
    float4 e = float4(ex / 255.0f, ey / 255.0f, ez / 255.0f, ew / 255.0f);
    return e;
}

void EncodeMatrix4x4(float2 start, float4x4 mat){
    Result[start + float2(0 ,0)] = EncodeFloatRGBA((mat[0][0]+100.)/200.);
    Result[start + float2(1 ,0)] = EncodeFloatRGBA((mat[0][1]+100.)/200.);
    Result[start + float2(2 ,0)] = EncodeFloatRGBA((mat[0][2]+100.)/200.);
    Result[start + float2(3 ,0)] = EncodeFloatRGBA((mat[0][3]+100.)/200.);
    Result[start + float2(4 ,0)] = EncodeFloatRGBA((mat[1][0]+100.)/200.);
    Result[start + float2(5 ,0)] = EncodeFloatRGBA((mat[1][1]+100.)/200.);
    Result[start + float2(6 ,0)] = EncodeFloatRGBA((mat[1][2]+100.)/200.);
    Result[start + float2(7 ,0)] = EncodeFloatRGBA((mat[1][3]+100.)/200.);
    Result[start + float2(8 ,0)] = EncodeFloatRGBA((mat[2][0]+100.)/200.);
    Result[start + float2(9 ,0)] = EncodeFloatRGBA((mat[2][1]+100.)/200.);
    Result[start + float2(10,0)] = EncodeFloatRGBA((mat[2][2]+100.)/200.);
    Result[start + float2(11,0)] = EncodeFloatRGBA((mat[2][3]+100.)/200.);
    Result[start + float2(12,0)] = EncodeFloatRGBA((mat[3][0]+100.)/200.);
    Result[start + float2(13,0)] = EncodeFloatRGBA((mat[3][1]+100.)/200.);
    Result[start + float2(14,0)] = EncodeFloatRGBA((mat[3][2]+100.)/200.);
    Result[start + float2(15,0)] = EncodeFloatRGBA((mat[3][3]+100.)/200.);
}

[numthreads(1,1,1)]
void Encode(uint3 id : SV_DispatchThreadID){
    Result[float2(0 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[0][0]+100.)/200.);
    Result[float2(1 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[0][1]+100.)/200.);
    Result[float2(2 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[0][2]+100.)/200.);
    Result[float2(3 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[0][3]+100.)/200.);
    Result[float2(4 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[1][0]+100.)/200.);
    Result[float2(5 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[1][1]+100.)/200.);
    Result[float2(6 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[1][2]+100.)/200.);
    Result[float2(7 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[1][3]+100.)/200.);
    Result[float2(8 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[2][0]+100.)/200.);
    Result[float2(9 ,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[2][1]+100.)/200.);
    Result[float2(10,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[2][2]+100.)/200.);
    Result[float2(11,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[2][3]+100.)/200.);
    Result[float2(12,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[3][0]+100.)/200.);
    Result[float2(13,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[3][1]+100.)/200.);
    Result[float2(14,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[3][2]+100.)/200.);
    Result[float2(15,0)] = EncodeFloatRGBA((camData[index]._CameraTransform[3][3]+100.)/200.);

    Result[float2(0 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[0][0]+100.)/200.);
    Result[float2(1 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[0][1]+100.)/200.);
    Result[float2(2 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[0][2]+100.)/200.);
    Result[float2(3 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[0][3]+100.)/200.);
    Result[float2(4 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[1][0]+100.)/200.);
    Result[float2(5 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[1][1]+100.)/200.);
    Result[float2(6 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[1][2]+100.)/200.);
    Result[float2(7 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[1][3]+100.)/200.);
    Result[float2(8 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[2][0]+100.)/200.);
    Result[float2(9 ,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[2][1]+100.)/200.);
    Result[float2(10,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[2][2]+100.)/200.);
    Result[float2(11,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[2][3]+100.)/200.);
    Result[float2(12,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[3][0]+100.)/200.);
    Result[float2(13,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[3][1]+100.)/200.);
    Result[float2(14,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[3][2]+100.)/200.);
    Result[float2(15,1)] = EncodeFloatRGBA((camData[index]._FrustrumMatrix[3][3]+100.)/200.);

    for(int i = 0; i < 60; i++){
        EncodeMatrix4x4(float2(i * 16, 539), movingTransforms[(index * 60) + i]);
    }

    Result[float2(959,0)] = float4(0,0,0,0);
}
