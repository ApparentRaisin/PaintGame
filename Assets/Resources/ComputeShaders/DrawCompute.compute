// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain
#include "UnityCG.cginc"
// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2DArray<half4> Result;
Texture2D<float> _CameraDepthTexture;
Texture2D<float4> _BrushTexture;
float4 _MouseData;
half4x4 _CameraTransform;
half4x4 _FrustrumMatrix;
float _Color;
float _TimeUnscaled;
int _Player;

float2 encode_float(float v) {
  float2 c = float2(0.0, 0.0);
  if (v < 0.0) { // if it's negative
    c[0] += 64.0;
    v = -v;
  }
  float f = 0.0;
  float e = ceil(log2(v)); // largest exponent of 2 that is larger
  float m = v * exp2(-e); // percentage of e
  if (e < 0.0) { // if it's a fraction
    e = -e;
    c[0] += 128.0;
  }
  c[0] += e;
  m *= 255.0;
  f = floor(m);
  c[1] = m;

  c[0] *= 3.921569E-03; // divide by 255
  c[1] *= 3.921569E-03;
  return c; // aka * 1/255
}

float Blur(Texture2D<float> tex, float2 uv, float sigma){
  float value = 1000;
  for(int x = -sigma; x <= sigma; x++){
    for(int y = -sigma; y <= sigma; y++){
      value = min(value,tex[uv+float2(x,y) * _ScreenParams.zw]);
    }
  }

  //value /= (((sigma*2.)+1.) * ((sigma*2.)+1.));
  return value;
}

float hash12(float2 p)
{
	  float3 p3  = frac(float3(p.xyx) * .1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    
    float size = _MouseData.w;
    // TODO: insert actual code here!
    float2 mouse = _MouseData.xy/_ScreenParams.xy;
    mouse *= float2(960,540);
    mouse -= id.xy - float2(256/size,256/size);
    mouse *= size;

    float2 uv = id.xy/float2(960,540);
    uv *= _ScreenParams.xy;
    float depthValue = Blur(_CameraDepthTexture, uv, 1);
    half dist =  0;//clamp((10 - distance(mouse,id.xy)),0,1) * _MouseData.z;
    if(mouse.x > 0 && mouse.x < 512 && mouse.y > 0 && mouse.y < 512 && _MouseData.z)
    {
      dist = hash12(floor(id.xy+float2(1,1)*_TimeUnscaled*10)) <= _BrushTexture[mouse].a * 1.05f;
    }

    //half dist =  clamp((10 - distance(mouse,id.xy)),0,1) * _MouseData.z;// * unity_DeltaTime * 10;
    half2 depth = encode_float(depthValue);
    //float ditherValue = _Dither[id.xy] < _BrushTexture[mouse].a;
    Result[uint3(id.xy,_Player)] = float4(lerp(Result[uint3(id.xy,_Player)].r, _Color, dist > 0.), clamp(Result[uint3(id.xy,_Player)].g + (dist> 0.),0,1),  dist > 0 ? depth : Result[uint3(id.xy,_Player)].ba);
    
    if(id.x == 959 && id.y == 0){
      Result[uint3(id.xy,_Player)] = float4((_Player+1)/5.,0,0,0);
    }
}




